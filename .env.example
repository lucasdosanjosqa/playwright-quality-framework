# Supported values: local, development, staging.
TEST_ENV=local

# Local has safe defaults. Set these explicitly for development and staging.
# APP_BASE_URL=https://application.example.test
# API_BASE_URL=https://api.example.test

# Optional until authentication is implemented. Always provide both values together.
# TEST_USERNAME=
# TEST_PASSWORD=

# CI providers should set this directly rather than storing it in a local .env file.
# CI=true
