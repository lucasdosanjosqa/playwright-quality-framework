{
  "name": "playwright-quality-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A production-grade Playwright and TypeScript Quality Engineering portfolio framework.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api --pass-with-no-tests",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:headed": "playwright test tests/e2e --headed",
    "test:debug": "playwright test tests/e2e --debug",
    "test:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  }
}
